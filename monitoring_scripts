1. Install Prometheus on EKS:

helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
helm repo update

helm install prometheus prometheus-community/prometheus --namespace monitoring --create-namespace


2.Install Node Exporter

helm install node-exporter prometheus-community/prometheus-node-exporter  --namespace monitoring


3.Expose a Custom Metric in Node.js App:

npm install prom-client

#      in the app side:

const express = require('express');
const client = require('prom-client');

const app = express();
const collectDefaultMetrics = client.collectDefaultMetrics;
collectDefaultMetrics();

const errorCounter = new client.Counter({
  name: 'app_errors_total',
  help: 'Total number of 5xx errors',
});

app.get('/error', (req, res) => {
  errorCounter.inc(); // increment error counter
  res.status(500).send('Internal Server Error');
});

app.get('/metrics', async (req, res) => {
  res.set('Content-Type', client.register.contentType);
  res.end(await client.register.metrics());
});

app.listen(3000, () => console.log('App listening on port 3000'));


4.Install Grafana with Prometheus Datasource:


helm install grafana grafana/grafana --namespace monitoring --set adminPassword='admin' --set service.type=CLUSTERIP

